---
// External link card, rendered as a nofollow link.
// Title comes from og:title/<title> via a cached build-time fetch (see
// src/utils/bookmark-title.ts); passing `title` skips the fetch entirely.
// Favicon uses Google's favicon service, so no page fetch is needed for it.
// Usage (in .mdx, adjust the relative path to your depth):
//   import BookmarkCard from '../../../../components/BookmarkCard.astro';
//   <BookmarkCard href="https://example.com/foo" />
//   <BookmarkCard href="..." title="Custom title" />
import { getBookmarkTitle } from '../utils/bookmark-title';

interface Props {
    href: string;
    title?: string;
}

const { href, title: titleProp } = Astro.props;

const domain = (() => {
    try {
        return new URL(href).hostname;
    } catch {
        return href;
    }
})();

const title = titleProp?.trim() || (await getBookmarkTitle(href)) || domain;
const favicon = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=32`;
---

<a class="link-card" href={href} rel="nofollow noopener noreferrer" target="_blank">
    <img
        class="link-card__icon"
        src={favicon}
        alt=""
        width="20"
        height="20"
        loading="lazy"
        onerror="this.remove()"
    />
    <span class="link-card__title">{title}</span>
    <span class="link-card__domain">{domain}</span>
</a>

<style>
    .link-card {
        display: inline;
        padding: 0 0.2rem;
        border-radius: 3px;
        color: var(--sl-color-white);
        background: color-mix(in srgb, var(--gray-4) 30%, transparent);
        transition: background 0.15s ease;
        text-decoration: none;
    }
    .link-card:hover {
        background: var(--gray-6);
    }
    .link-card__icon {
        vertical-align: text-bottom;
        margin-right: 0.35em;
        border-radius: 4px;
        display: inline-block;
    }
    .link-card__title {
        word-break: break-word;
        border-bottom: solid var(--gray-4) 1px;
    }
    .link-card__domain {
        margin-left: 0.4em;
        font-size: 0.4em;
        color: var(--sl-color-gray-3);
    }
</style>
